# Copy to .env and replace every <PLACEHOLDER> with your own value.
# Never commit real key material.

# ===========================================================================
# NETWORK MODE — REQUIRED before any paid call. There is NO default. With a
# payment key loaded and this unset (or not "mainnet"/"devnet"), every
# x402_fetch refuses with NETWORK_NOT_CONFIGURED BEFORE probing; free tools
# keep working. Pick explicitly:
X402_NETWORK_MODE=mainnet
# ===========================================================================
#   "mainnet" — pays real money on mainnet networks (the asset table's
#               mainnet entries only; EVM testnets are refused).
#   "devnet"  — pays ONLY the Solana devnet (solana:EtWTRAB…, the x402 lab
#               devnet) — see docs/networks.md (devnet mode). Set
#               SOLANA_DEVNET_RPC_URL for that mode's RPC:
# SOLANA_DEVNET_RPC_URL=<YOUR_SOLANA_DEVNET_RPC_URL>

SOLANA_PRIVATE_KEY=<YOUR_SOLANA_PRIVATE_KEY>
EVM_PRIVATE_KEY=<YOUR_EVM_PRIVATE_KEY>
# CASPER_PRIVATE_KEY accepts a hex key, a PEM file path, or PEM contents.
CASPER_PRIVATE_KEY=<YOUR_CASPER_PRIVATE_KEY>
CASPER_KEY_ALGORITHM=ed25519
# Paid Casper requests are disabled until BOTH decimal wCSPR budgets are set.
CASPER_MAX_PAYMENT_PER_CALL=
CASPER_MAX_DAILY_SPEND=
# RPC URLs are placeholders too; if left unset, the code falls back to the
# documented public endpoints — mainnet: (https://api.mainnet-beta.solana.com,
# https://mainnet.base.org); devnet: the SDK's documented devnet RPC, used
# ONLY while X402_NETWORK_MODE=devnet; a mainnet RPC is never touched in
# devnet mode and vice versa.
SOLANA_RPC_URL=<YOUR_SOLANA_RPC_URL>
BASE_RPC_URL=<YOUR_BASE_RPC_URL>
MAX_PAYMENT_PER_CALL=0.50
MAX_DAILY_SPEND=10.00
# Both caps fail closed — a value that is not a plain
# non-negative decimal (e.g. "abc", "1e3", "-1", empty string) reads as 0
# and DISABLES payments until fixed; it never silently widens the cap.
# ---------------------------------------------------------------------------
# The OPTIONAL cross-chain spending ceiling — a daily total across
# EVERY budget rail (the USD rail's ledger buckets; a Casper rail priced by
# its explicitly configured rate below). UNSET means no ceiling;
# there is NO default. A rail with no usable USD rate is refused outright
# while the ceiling is active (code RAIL_DISABLED_NO_RATE) — an unpriced rail
# is never assumed to fit. Garbage reads 0 (refuse everything) like the caps.
# MAX_DAILY_SPEND_TOTAL_USD=2.00
# The USD rail's USD rate for that total — usually unset (the USD
# rail prices natively at the peg; setting it OVERRIDES the peg, and garbage
# fails the rate closed with one stderr line).
# X402_RATE_USDC_USD=1.00
# The Casper rail's USD rate (per whole CSPR) — REQUIRED for
# Casper spend to count toward MAX_DAILY_SPEND_TOTAL_USD; unset means the
# rail is unpriced (and disabled for paid calls while a ceiling is active).
# An operator-priced wCSPR entry in the policy config's assets.extensions
# also prices the rail; the env var wins if both exist. NEVER a CapBinding:
# the mote budgets CASPER_MAX_PAYMENT_PER_CALL / CASPER_MAX_DAILY_SPEND stay
# the only spend controls for the Casper leg.
# X402_RATE_WCSPR_USD=0.25
# Ledger location: an explicit PAYMENT_LOG_PATH wins outright. When unset,
# the ledger lives at <X402_STATE_DIR|~/.x402-agent-mcp>/x402-payments.jsonl
# and a legacy working-directory x402-payments.jsonl is counted once,
# read-only (an upgrade never resets today's spend to 0).
PAYMENT_LOG_PATH=./x402-payments.jsonl
# Per-user state directory holding the spend ledger when PAYMENT_LOG_PATH is
# unset.
# X402_STATE_DIR=~/.x402-agent-mcp
# Override the endpoint directory location (read/write). Defaults to
# <repo>/endpoints.json. Set this in tests/sandboxes so the live file is never touched.
X402_DIRECTORY_PATH=./endpoints.json
# Loopback/private hosts allowed past the transport guard for local
# dev, as host:port pairs. Env-only — tool callers cannot extend it. Empty by
# default (all private/loopback targets refused). https-only still applies.
# X402_ALLOW_PRIVATE_HOSTS=127.0.0.1:8921,localhost:8922
# x402_fetch extra caller headers — DENY BY DEFAULT. Comma-separated
# header names (case-insensitive); empty means x402_fetch refuses every extra
# header. Hard-denied names (Authorization, Cookie, Host, transfer-encoding,
# payment-*/x-payment*, hop-by-hop) can never be allowlisted. Values are never
# logged or written to the ledger.
# X402_EXTRA_HEADER_ALLOWLIST=x-client-id
# Cap for untrusted seller/directory text per field (controls and
# ANSI escapes are always stripped; truncation is marked with the original
# size). Defaults: 100000 chars for bodies, 1000 for a rendered payment-
# requirement blob, 2000 for scraped directory text.
# X402_MAX_UNTRUSTED_CHARS=
# The paid request aborts after this many milliseconds if the
# seller never answers, surfacing a fixed PAID_TIMEOUT refusal instead of a
# hang. Whole-digit positive integers only (any other value fails startup).
# X402_PAID_TIMEOUT_MS=30000
# Challenge signing scope — what a seller's 402 challenge may
# make these wallets sign. Every rule refuses, never clamps or repairs.
# Challenge `extensions` allowlist. A challenge carrying an extension key
# outside this list is refused (EXTENSION_NOT_ALLOWED). Default is "bazaar"
# (the x402 discovery extension), which matches the first-party sellers in
# the endpoint directory. Setting the variable REPLACES the default list.
# X402_ALLOWED_EXTENSIONS=bazaar
# Additional `extra` fields a challenge may carry beyond the SDK's known-safe
# signing fields (name/version/feePayer/memo/lastValidBlockHeight — always in
# scope under their own value rules). Unknown extra keys are refused, never
# forwarded to a signer. Comma-separated; empty by default.
# X402_ALLOWED_EXTRA_KEYS=
# Maximum validity window (seconds) a challenge may request. A challenge
# asking to keep a signature valid longer is refused, never clamped.
# X402_MAX_CHALLENGE_TIMEOUT_SECONDS=300
# Maximum byte length of a challenge's extra.memo (printable ASCII only,
# bound into the payment intent).
# X402_MAX_MEMO_BYTES=64
# Solana fee payer: a challenge that sets extra.feePayer to THIS wallet's own
# address would make the agent pay the seller's gas. Refused by default.
# X402_ALLOW_SELF_FEE_PAYER=0
# Optionally pin the fee-payer addresses a challenge may name (base58,
# comma-separated). Empty means no operator pin beyond the self-payer rule.
# X402_FEE_PAYER_ALLOWLIST=
# ---------------------------------------------------------------------------
# Policy config + trust allowlists: point POLICY_CONFIG_PATH at a policy
# config file (template: policy.example.json) and pin the TRUSTED/BLOCKED
# host allowlists. The gate, its knobs and their exact semantics are
# documented in docs/policy.md.
# POLICY_CONFIG_PATH=
# POLICY_TRUSTED_HOSTS=
# POLICY_BLOCKED_HOSTS=
# Opt-in policy profile — exact lowercase "strict" | "standard" | "permissive".
# Unset = "permissive", the behavior-compat default (every service payable at
# the global caps); docs/policy.md states the caps each profile applies.
# X402_POLICY_PROFILE=
# Policy-engine env overrides (each fails closed on a malformed value —
# never silently ignored; docs/policy.md):
# X402_POLICY_PAYMENTS_ENABLED=
# X402_POLICY_MAX_PER_REQUEST=
# X402_POLICY_MAX_DAILY=
# X402_POLICY_NETWORKS=
# X402_POLICY_TOKENS=
# Per-level overrides — LEVEL is one of:
# unknown|discovered|verified|trusted|blocked
# X402_POLICY_SERVICE_<LEVEL>=
# X402_POLICY_SERVICE_<LEVEL>_MAX_PER_REQUEST=
# X402_POLICY_SERVICE_<LEVEL>_MAX_DAILY=
# Comma-separated CAIP-2 ids the configured facilitator settles:
# X402_EVM_FACILITATOR_NETWORKS=
# Payment-intent time-to-live in milliseconds (docs/payments.md):
# X402_INTENT_TTL_MS=
# ---------------------------------------------------------------------------
# Key aliases and chain selection: BASE_PRIVATE_KEY is an accepted alias of
# EVM_PRIVATE_KEY for Base/Polygon/Arbitrum, and CASPER_NETWORK forces
# casper:casper or casper:casper-test when a server offers both (unset
# follows the network mode — see docs/networks.md).
# BASE_PRIVATE_KEY=
# CASPER_NETWORK=
# ---------------------------------------------------------------------------
# Pre-push security scan (scripts/pre-push-security-scan.sh) — script-only
# environment for the git hook, never read by the server (docs/operations.md):
# X402_SCAN_WALLET_PATTERNS_FILE=
# X402_KNOWN_WALLETS=
# BLOCKED_NAME_PATTERNS=
