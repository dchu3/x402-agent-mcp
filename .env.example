# Copy to .env and replace every <PLACEHOLDER> with your own value.
# Never commit real key material.
SOLANA_PRIVATE_KEY=<YOUR_SOLANA_PRIVATE_KEY>
EVM_PRIVATE_KEY=<YOUR_EVM_PRIVATE_KEY>
# CASPER_PRIVATE_KEY accepts a hex key, a PEM file path, or PEM contents.
CASPER_PRIVATE_KEY=<YOUR_CASPER_PRIVATE_KEY>
CASPER_KEY_ALGORITHM=ed25519
# Paid Casper requests are disabled until BOTH decimal wCSPR budgets are set.
CASPER_MAX_PAYMENT_PER_CALL=
CASPER_MAX_DAILY_SPEND=
# RPC URLs are placeholders too; if left unset, the code falls back to the
# documented public endpoints (https://api.mainnet-beta.solana.com, https://mainnet.base.org).
SOLANA_RPC_URL=<YOUR_SOLANA_RPC_URL>
BASE_RPC_URL=<YOUR_BASE_RPC_URL>
MAX_PAYMENT_PER_CALL=0.50
MAX_DAILY_SPEND=10.00
# Issue #53/#54: both caps fail closed — a value that is not a plain
# non-negative decimal (e.g. "abc", "1e3", "-1", empty string) reads as 0
# and DISABLES payments until fixed; it never silently widens the cap.
# Ledger location: an explicit PAYMENT_LOG_PATH wins outright. When unset,
# the ledger lives at <X402_STATE_DIR|~/.x402-agent-mcp>/x402-payments.jsonl
# and a legacy working-directory x402-payments.jsonl is counted once,
# read-only (an upgrade never resets today's spend to 0).
PAYMENT_LOG_PATH=./x402-payments.jsonl
# Per-user state directory holding the spend ledger when PAYMENT_LOG_PATH is
# unset (issue #54).
# X402_STATE_DIR=~/.x402-agent-mcp
# Override the endpoint directory location (read/write). Defaults to
# <repo>/endpoints.json. Set this in tests/sandboxes so the live file is never touched.
X402_DIRECTORY_PATH=./endpoints.json
# Issue #58: loopback/private hosts allowed past the transport guard for local
# dev, as host:port pairs. Env-only — tool callers cannot extend it. Empty by
# default (all private/loopback targets refused). https-only still applies.
# X402_ALLOW_PRIVATE_HOSTS=127.0.0.1:8921,localhost:8922
# Issue #64: x402_fetch extra caller headers — DENY BY DEFAULT. Comma-separated
# header names (case-insensitive); empty means x402_fetch refuses every extra
# header. Hard-denied names (Authorization, Cookie, Host, transfer-encoding,
# payment-*/x-payment*, hop-by-hop) can never be allowlisted. Values are never
# logged or written to the ledger.
# X402_EXTRA_HEADER_ALLOWLIST=x-client-id
# Issue #63: cap for untrusted seller/directory text per field (controls and
# ANSI escapes are always stripped; truncation is marked with the original
# size). Defaults: 100000 chars for bodies, 1000 for a rendered payment-
# requirement blob, 2000 for scraped directory text.
# X402_MAX_UNTRUSTED_CHARS=
