SOLANA_PRIVATE_KEY=your-base58-solana-private-key
EVM_PRIVATE_KEY=your-hex-base-private-key
CASPER_PRIVATE_KEY=your-hex-casper-private-key-or-pem-path
CASPER_KEY_ALGORITHM=ed25519
# Paid Casper requests are disabled until BOTH decimal wCSPR budgets are set.
CASPER_MAX_PAYMENT_PER_CALL=
CASPER_MAX_DAILY_SPEND=
# Nano (opt-in): your node's wallet RPC sends and confirms the block.
# Paid Nano requests are disabled until BOTH decimal XNO budgets are set and
# nano/XNO are added to the policy allowlists.
# NANO_RPC_URL: your node's RPC endpoint (wallet RPC enabled). Keep it on
# localhost or a private network.
NANO_RPC_URL=
# NANO_WALLET_ID: node wallet id holding the source account's key - treat it as a secret.
NANO_WALLET_ID=
NANO_SOURCE_ACCOUNT=
NANO_MAX_PAYMENT_PER_CALL=
NANO_MAX_DAILY_SPEND=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BASE_RPC_URL=https://mainnet.base.org
MAX_PAYMENT_PER_CALL=0.50
MAX_DAILY_SPEND=10.00
PAYMENT_LOG_PATH=./x402-payments.jsonl
# Override the endpoint directory location (read/write). Defaults to
# <repo>/endpoints.json. Set this in tests/sandboxes so the live file is never touched.
X402_DIRECTORY_PATH=./endpoints.json
